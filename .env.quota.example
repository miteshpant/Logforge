# Quota Reset Configuration Environment Variables
# Configure automated quota reset periods for each quota type (in days)
# Set to 0 to disable automatic reset for that quota type

# Daily ingestion quota - reset every day (1 day)
QUOTA_RESET_DAILY_INGESTION_DAYS=1

# Monthly ingestion quota - reset every month (30 days)
QUOTA_RESET_MONTHLY_INGESTION_DAYS=30

# Storage quota - never reset automatically (users accumulate storage)
QUOTA_RESET_STORAGE_GB_DAYS=0

# API calls quota - reset every month (30 days)
QUOTA_RESET_API_CALLS_DAYS=30

# Users quota - never reset automatically (subscription-based)
QUOTA_RESET_USERS_DAYS=0

# Alerts quota - reset every month (30 days)
QUOTA_RESET_ALERTS_DAYS=30

# Quota reset scheduler configuration
# How often to check for quotas that need reset (in minutes)
QUOTA_RESET_CHECK_INTERVAL_MINUTES=60

# Example Production Configuration:
# QUOTA_RESET_DAILY_INGESTION_DAYS=1     # Reset daily ingestion every day
# QUOTA_RESET_MONTHLY_INGESTION_DAYS=30  # Reset monthly ingestion every 30 days
# QUOTA_RESET_STORAGE_GB_DAYS=0          # Storage never resets (cumulative)
# QUOTA_RESET_API_CALLS_DAYS=30          # API calls reset monthly
# QUOTA_RESET_USERS_DAYS=0               # User count based on subscription
# QUOTA_RESET_ALERTS_DAYS=30             # Alert quota resets monthly
# QUOTA_RESET_CHECK_INTERVAL_MINUTES=60  # Check every hour

# Example Development Configuration:
# QUOTA_RESET_DAILY_INGESTION_DAYS=1     # Reset daily for testing
# QUOTA_RESET_MONTHLY_INGESTION_DAYS=7   # Reset weekly for faster testing
# QUOTA_RESET_STORAGE_GB_DAYS=0          # Never reset storage
# QUOTA_RESET_API_CALLS_DAYS=7           # Reset API calls weekly
# QUOTA_RESET_USERS_DAYS=0               # Never reset users
# QUOTA_RESET_ALERTS_DAYS=7              # Reset alerts weekly
# QUOTA_RESET_CHECK_INTERVAL_MINUTES=10  # Check every 10 minutes for faster testing