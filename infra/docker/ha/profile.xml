<!-- HA compose: the Replicated database engine is marked experimental in
     ClickHouse 23.8 (production-ready in later releases); see docs/deployment.md. -->
<clickhouse>
  <profiles>
    <default>
      <allow_experimental_database_replicated>1</allow_experimental_database_replicated>
      <allow_experimental_object_type>1</allow_experimental_object_type>
    </default>
  </profiles>
</clickhouse>
