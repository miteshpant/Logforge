<!--
  LF-031: hot -> cold storage tiering (local disk -> S3/MinIO).

  init.sql promised "S3 storage policy will be configured via
  config.d/s3_storage.xml" but the file never existed, so the live tables had
  a plain 30-day DELETE TTL: data was destroyed at 30 days instead of aged to
  cheap object storage.

  This file defines:
    * disk `s3_cold`   - the MinIO bucket from compose.yml (`logforge-cold`,
                         created via the S3 API; MinIO does not auto-create).
    * policy `tiered`  - volume `hot` (the default local disk) then volume
                         `cold` (s3_cold). It contains the `default` disk, so
                         existing tables can switch with
                         `ALTER TABLE ... MODIFY SETTING storage_policy='tiered'`.

  DEPLOYMENT
  compose.yml must mount this directory into the server:
      - ./clickhouse/config.d/s3_storage.xml:/etc/clickhouse-server/config.d/s3_storage.xml
  (the clickhouse service currently mounts only init_simple.sql). For a
  non-Docker/production deployment, replace endpoint + credentials with the
  real object store; prefer use_environment_credentials there.

  Tables opt in via migration 015_cold_tiering.sql:
      TTL toDateTime(ts) + toIntervalDay(7)   TO VOLUME 'cold',
          toDateTime(ts) + toIntervalDay(365) DELETE

  ROLLBACK
  ALTER TABLE ... MODIFY TTL <previous ttl>; then
  ALTER TABLE ... MOVE PARTITION <p> TO VOLUME 'hot' for any moved parts,
  before removing this file.
-->
<clickhouse>
  <storage_configuration>
    <disks>
      <s3_cold>
        <type>s3</type>
        <endpoint>http://minio:9000/logforge-cold/clickhouse/</endpoint>
        <access_key_id>minio</access_key_id>
        <secret_access_key>minio123</secret_access_key>
        <use_environment_credentials>false</use_environment_credentials>
        <region>us-east-1</region>
        <path_style_access>true</path_style_access>
        <metadata_path>/var/lib/clickhouse/disks/s3_cold/</metadata_path>
      </s3_cold>
    </disks>
    <policies>
      <tiered>
        <volumes>
          <hot>
            <disk>default</disk>
          </hot>
          <cold>
            <disk>s3_cold</disk>
            <prefer_not_to_merge>true</prefer_not_to_merge>
          </cold>
        </volumes>
        <move_factor>0.1</move_factor>
      </tiered>
    </policies>
  </storage_configuration>
</clickhouse>
