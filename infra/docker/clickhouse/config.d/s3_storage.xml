<!--
  Storage tiers (Phase 12, docs/storage.md).

  * disk `s3_warm`      the warm tier: an S3 bucket (MinIO in compose).
  * policy `tiered`     the hot volume (named `default`, on the local disk),
                        then volume `warm` (s3_warm). ClickHouse only lets a
                        table switch to a policy holding the old policy's
                        volumes by name, so the hot volume keeps the name
                        `default`. The API switches existing tables with
                        `ALTER TABLE ... MODIFY SETTING storage_policy='tiered'`
                        and sets each table's TTL (... TO VOLUME 'warm').
  * named collections   `logforge_archive`: the cold tier, Parquet archives
                        written and read by the s3() table function;
                        `logforge_backups`: BACKUP/RESTORE (apps/api/backup.py).
                        Either way the credentials never appear in queries
                        or query_log.

  Credentials come from the server's environment (LOGFORGE_S3_*); compose sets
  them to MinIO's. The API creates the buckets (ClickHouse can't), so the disk
  skips its access check at startup.

  ROLLBACK: ALTER TABLE ... MODIFY TTL <a TTL without TO VOLUME>, then
  ALTER TABLE ... MOVE PARTITION <p> TO VOLUME 'default' for parts on warm, before
  removing this file.
-->
<clickhouse>
  <storage_configuration>
    <disks>
      <s3_warm>
        <type>s3</type>
        <endpoint from_env="LOGFORGE_S3_WARM_ENDPOINT"/>
        <access_key_id from_env="LOGFORGE_S3_ACCESS_KEY"/>
        <secret_access_key from_env="LOGFORGE_S3_SECRET_KEY"/>
        <region>us-east-1</region>
        <skip_access_check>true</skip_access_check>
        <metadata_path>/var/lib/clickhouse/disks/s3_warm/</metadata_path>
      </s3_warm>
    </disks>
    <policies>
      <tiered>
        <volumes>
          <default>
            <disk>default</disk>
          </default>
          <warm>
            <disk>s3_warm</disk>
            <prefer_not_to_merge>true</prefer_not_to_merge>
          </warm>
        </volumes>
        <move_factor>0.1</move_factor>
      </tiered>
    </policies>
  </storage_configuration>
  <named_collections>
    <logforge_archive>
      <url from_env="LOGFORGE_S3_ARCHIVE_URL"/>
      <access_key_id from_env="LOGFORGE_S3_ACCESS_KEY"/>
      <secret_access_key from_env="LOGFORGE_S3_SECRET_KEY"/>
    </logforge_archive>
    <!-- Backups (apps/api/backup.py): BACKUP ... TO S3(logforge_backups, '<name>') -->
    <logforge_backups>
      <url from_env="LOGFORGE_S3_BACKUP_URL"/>
      <access_key_id from_env="LOGFORGE_S3_ACCESS_KEY"/>
      <secret_access_key from_env="LOGFORGE_S3_SECRET_KEY"/>
    </logforge_backups>
  </named_collections>
</clickhouse>
