<clickhouse>
  <storage_configuration>
    <disks>
      <shared_s3_disk>
        <type>s3</type>
        <endpoint>https://s3.us-east-1.amazonaws.com/logforge-shared-gov_agency/</endpoint>
        <access_key_id>minio</access_key_id>
        <secret_access_key>minio123</secret_access_key>
        <use_environment_credentials>false</use_environment_credentials>
        <region>us-east-1</region>
        <path_style_access>true</path_style_access>
        <metadata_path>/var/lib/clickhouse/disks/shared_s3_disk/</metadata_path>
        </shared_s3_disk>
      </disks>
    <policies>
      <default_policy>
        <volumes>
          <hot>
            <disk>default</disk>
            </hot>
          <cold>
            <disk>shared_s3_disk</disk>
            </cold>
          </volumes>
        <move_factor>0.1</move_factor>
        <prefer_not_to_merge>true</prefer_not_to_merge>
        </default_policy>
      </policies>
    </storage_configuration>
  </clickhouse>
